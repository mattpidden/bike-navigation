# Secrets — never commit real keys. Copy app/assets/.env.example to
# app/assets/.env and fill in your own Google Maps API key.
.env
*.env
!*.env.example

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Claude Code's personal/local settings — not shared project config
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# maps/ pipeline: large source/intermediate files, regenerated by
# build_map.py from a BBBike .osm.pbf extract you download yourself — see
# README. maps/map.bin (the actual baked asset) and
# maps/thames_tidal_os.geojson (not regeneratable from the OSM extract, see
# README) are kept.
maps/*.osm.pbf
maps/roads_raw.geojson
maps/areas_raw.geojson

# firmware/: vendored third-party Arduino library — install it yourself
# (Arduino Library Manager or PlatformIO), see README. Our own hardware
# config lives in firmware/libaries/TFT_eSPI_Setups/, which IS tracked.
firmware/libaries/TFT_eSPI/

# app/: Flutter's own generated files (app/.gitignore, app/ios/.gitignore,
# app/android/.gitignore already cover most of this — this is just the
# equivalent at repo root, for tools run from here by mistake).
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Original, un-stripped photos (contain GPS EXIF) — README uses the
# metadata-stripped copies in docs/images/.
photos/
