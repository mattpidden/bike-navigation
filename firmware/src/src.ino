// Extra Functions
void setState(AppState newState) {
  currentState = newState;
  tft.fillScreen(TFT_BLACK); // clear when switching
}

class ServerCallbacks : public BLEServerCallbacks {
  void onConnect(BLEServer* pServer) {
    Serial.print("Connected to phone...");
    deviceConnected = true;
  }
  void onDisconnect(BLEServer* pServer) {
    Serial.print("Disconnected...");
    pServer->startAdvertising();
    deviceConnected = false;
  }
};


class MyCallbacks : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *pCharacteristic) override {
    Serial.println("BLE written to...");
    String value = pCharacteristic->getValue();
    if (value.length() > 0) {
      Serial.println("Value found");
      // Parse JSON
      StaticJsonDocument<256> doc; // adjust size as needed
      DeserializationError error = deserializeJson(doc, value);
      if (error) {
        Serial.print("JSON parse failed: ");
        Serial.println(error.c_str());
        return;
      }

      // Update time if present
      if (doc.containsKey("timestamp")) {
        uint64_t millisecondsSinceEpoch = doc["timestamp"].as<uint64_t>();
        time_t now = (millisecondsSinceEpoch / 1000);  // convert to seconds
        struct tm *timeinfo = gmtime(&now);
      
        char buffer[6];
        snprintf(buffer, sizeof(buffer), "%02d:%02d", timeinfo->tm_hour, timeinfo->tm_min);
        currentTime = String(buffer);
      
        Serial.print("Updated time: ");
        Serial.println(currentTime);
      }

      // change state, if 'home', 'nav', 'arrived'
      if (doc.containsKey("mode")) {
        String mode = doc["mode"].as<String>();
        Serial.print("Mode: ");
        Serial.println(mode);
      
        if (mode == "home") {
          currentState = STATE_HOME;
        } else if (mode == "nav") {
          currentState = STATE_NAVIGATION;
        } else if (mode == "arrived") {
          currentState = STATE_ARRIVED;
        } else {
          Serial.println("Unknown mode received");
          currentState = STATE_HOME;
        }
      }

      if (doc.containsKey("icon")) {
        String nav = doc["icon"].as<String>();
        Serial.print("Nav: ");
        Serial.println(nav);
      
        if (nav == "left") {
          currentNavInstruction = NAV_LEFT;
        } else if (nav == "right") {
          currentNavInstruction = NAV_RIGHT;
        } else if (nav == "uturn") {
          currentNavInstruction = NAV_UTURN;
        } else if (nav == "straight") {
          currentNavInstruction = NAV_STRAIGHT;
        } else if (nav == "finish") {
          currentNavInstruction = NAV_FINISH;
        } else {
          Serial.println("Unknown nav instruction received");
          currentNavInstruction = NAV_STRAIGHT;
        }
      }

      if (doc.containsKey("distance")) {
        currentDistance = doc["distance"].as<String>();
      }

      if (doc.containsKey("road")) {
        nextRoad = doc["road"].as<String>();
      }
    }
    Serial.println("End of function");
  }
};

void setupBLE() {
  BLEDevice::init("ESP32");
  BLEServer *pServer = BLEDevice::createServer();
  pServer->setCallbacks(new ServerCallbacks());
  
  BLEService *pService = pServer->createService("12345678-1234-1234-1234-1234567890ab");
  BLECharacteristic *pCharacteristic = pService->createCharacteristic(
      "87654321-4321-4321-4321-ba0987654321",
      BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_READ);
  pCharacteristic->setCallbacks(new MyCallbacks());
  pCharacteristic->addDescriptor(new BLE2902());
  pCharacteristic->setValue("09:41");
  
  pService->start();
  
  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(pService->getUUID());
  pAdvertising->setScanResponse(true);
  pAdvertising->setMinPreferred(0x06);
  pAdvertising->setMaxPreferred(0x12);
  pAdvertising->start();
  
  Serial.println("BLE ready. Connect and send time string.");

}

void drawCenteredText(String text, int y, int textsize, uint16_t color = TFT_WHITE) {
  frame.setTextColor(color);
  frame.setTextFont(2);
  frame.setTextSize(textsize);
  int16_t h = frame.fontHeight();
  int16_t w = frame.textWidth(text);
  frame.setCursor((240 - w) / 2, y - (h / 2));
  frame.print(text);
}


// -------------------------------------------------------------------------
// Setup
// -------------------------------------------------------------------------
void setup(void) {
  Serial.begin(115200);
  delay(5000);
  Serial.println("Board On!");
  Wire.begin(6, 7);   // SDA=6, SCL=7
  delay(200);
  QMI8658_init();      // starts IMU
  Serial.println("IMU On");
  tft.init();
  tft.setRotation(0);
  tft.fillScreen(TFT_BLACK);
  Serial.println("Screen On!");
  frame.createSprite(240, 240);
  setupBLE();
}


// -------------------------------------------------------------------------
// Main loop
// -------------------------------------------------------------------------
void drawHomeScreen() {
  frame.fillSprite(TFT_BLACK);
  // Read IMU
  float acc[3], gyro[3];
  unsigned int tim_count;
  QMI8658_read_xyz(gyro, acc, &tim_count);  
  float acc_mag = sqrt(acc[0]*acc[0] + acc[1]*acc[1] + acc[2]*acc[2]);
  float vx = 0;
  float vy = 0;
  vx = gyro[0] / -100.0;  
  vy = gyro[1] / -100.0;
  ballX += vx;
  ballY += vy;
  float dx = ballX - centerX;
  float dy = ballY - centerY;
  float dist = sqrt(dx*dx + dy*dy);
  float maxDist = screenRadius - ballRadius;
  
  if (dist > maxDist) {
    // push the ball back to the edge along the vector from center
    float scale = maxDist / dist;
    ballX = centerX + dx * scale;
    ballY = centerY + dy * scale;
  }
  
  if (deviceConnected) {
    frame.drawBitmap(110, 215, ble_bitmap, 20, 20, TFT_WHITE);
  }
  frame.fillCircle((int)ballX, (int)ballY, ballRadius, tft.color565(255, 140, 0));
  drawCenteredText(batteryStatus, 15, 1);
  drawCenteredText(currentTime, 120, 3);
  frame.pushSprite(0, 0);
}

void drawNavigationScreen() {
  frame.fillSprite(TFT_BLACK);
  if (currentNavInstruction == NAV_STRAIGHT) {
    frame.drawBitmap(60, 50, straight_bitmap, 120, 120, TFT_WHITE);
    drawCenteredText(nextRoad, 180, 1);
    drawCenteredText(currentDistance, 210, 2);
  } else if (currentNavInstruction == NAV_RIGHT) {
    frame.drawBitmap(60, 50, right_bitmap, 120, 120, TFT_WHITE);
    drawCenteredText(nextRoad, 180, 1);
    drawCenteredText(currentDistance, 210, 2);
  } else if (currentNavInstruction == NAV_LEFT) {
    frame.drawBitmap(60, 50, left_bitmap, 120, 120, TFT_WHITE);
    drawCenteredText(nextRoad, 180, 1);
    drawCenteredText(currentDistance, 210, 2);
  } else if (currentNavInstruction == NAV_UTURN) {
    drawCenteredText(nextRoad, 180, 1);
    drawCenteredText("U-TURN", 60, 2);
    drawCenteredText(currentDistance, 210, 2);
  } else if (currentNavInstruction == NAV_FINISH) {
    frame.drawBitmap(60, 50, straight_bitmap, 120, 120, TFT_WHITE);
    drawCenteredText("Arriving...", 180, 1);
    drawCenteredText(currentDistance, 210, 2);
  }
  drawCenteredText(batteryStatus, 15, 1);
  frame.pushSprite(0, 0);
}

void drawArrivedScreen() {
  frame.fillSprite(TFT_BLACK);
  drawCenteredText("ARRIVED", 120, 3);
  drawCenteredText(batteryStatus, 15, 1);
  frame.pushSprite(0, 0);
}

static unsigned long lastBatteryUpdate = 0;

void loop() {
  if (millis() - lastBatteryUpdate >= 1000) {  // every 1 second
    lastBatteryUpdate = millis();
    uint16_t result = DEC_ADC_Read();
    const float conversion_factor = 3.3f / 4095.0f * 3.8f;
    float voltage = result * conversion_factor;
    float percent = (voltage - 3.0f) / (4.1f - 3.0f) * 100.0f;
    percent = constrain(percent, 0.0f, 100.0f);
    batteryStatus = String(voltage, 2) + "V  (" + String(percent, 0) + "%)";
    Serial.println(batteryStatus);
  }
  if (!deviceConnected) {
    drawHomeScreen();
    return;
  }
  switch (currentState) {
    case STATE_HOME:
      drawHomeScreen();
      break;

    case STATE_NAVIGATION:
      drawNavigationScreen();
      break;

    case STATE_ARRIVED:
      drawArrivedScreen();
      break;
  }
}
